# The Lab Reptiles Backend - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SESSION_SECRET=your-random-secret-key-here-change-in-production

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here
# For production, use a bcrypt hash instead:
# ADMIN_PASSWORD_HASH=$2b$12$...your-hash-here...

# Google Sheets Configuration
# Option 1: Use a credentials file
GOOGLE_CREDENTIALS_PATH=credentials.json

# Option 2: For Railway/Render, paste the entire JSON as a string
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# Google Sheet ID (from the URL)
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Email Notifications (optional)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
NOTIFICATION_EMAIL=your-email@example.com

# Port (Railway will set this automatically)
PORT=5000
